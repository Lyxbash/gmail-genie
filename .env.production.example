# Gmail Genie — production / Docker environment template
# Copy to `.env` in project root (never commit a populated `.env`):
#   copy .env.production.example .env
#
# Use placeholder values only. Add real secrets locally or via your host secret store.

# --- Runtime ---
APP_ENVIRONMENT=production
LOG_LEVEL=WARNING

# --- Secrets (optional) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gmail API ---
GMAIL_HTTP_TIMEOUT_SECONDS=120

# --- Ollama on host (Docker Desktop) ---
OLLAMA_HOST=host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- CORS — origins that may call the API ---
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# --- Frontend build-time API base (Docker) ---
VITE_API_BASE=http://localhost:8000

# --- Optional: expose OpenAPI in production (default: hidden) ---
# ENABLE_OPENAPI=false
