# Gmail Genie — local development environment template
# Copy to project root (never commit the real `.env`):
#   copy .env.example .env
#
# Fill in only what you use. Leave keys empty if optional features are disabled.

# --- Secrets (optional) ---
# Groq escalation — leave empty to use Ollama-only mode
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Runtime ---
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Gmail API ---
GMAIL_HTTP_TIMEOUT_SECONDS=120

# --- Ollama (local inference) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=127.0.0.1:11434

# --- Frontend / CORS (comma-separated origins) ---
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend API URL (Vite dev / build) ---
VITE_API_BASE=http://127.0.0.1:8000
